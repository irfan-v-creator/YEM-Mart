# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for persistent PostgreSQL storage on Vercel / Production)
# Obtain these from your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-supabase-publishable-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ADMIN AUTHENTICATION & SECURITY (REQUIRED)
# Secure cryptographic hash (Argon2id or bcrypt) of the admin passkey.
# Generate via `npm run hash-password` and paste here.
# Example Argon2id: $argon2id$v=19$m=65536,t=3,p=4$...
# Example bcrypt: $2b$12$...
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$..."

# Legacy plain-text password (Only used as backward-compatible fallback if ADMIN_PASSWORD_HASH is not yet set)
# ADMIN_PASSWORD="your-strong-admin-passkey-here"

# Cryptographic secret key used to sign and verify stateless HMAC-SHA256 admin tokens.
# Must be a high-entropy secret (at least 32 characters, e.g. `openssl rand -hex 32`).
ADMIN_AUTH_SECRET="your-32-plus-character-random-signing-secret"
